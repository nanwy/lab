# 浏览器统一访问本地 /api；真实服务通过可选开发代理接入。
VITE_API_BASE_URL=/api
# 只接受 true/false。开发默认开启；生产始终关闭模拟。
VITE_ENABLE_MSW=true
# 真实本地开发：在 .env.development.local 设置 VITE_ENABLE_MSW=false，
# 并配置以下服务端变量。不要为凭据增加 VITE_ 前缀，不提交本地配置。
# LOCAL_API_TARGET=http://xueyuan.chuzelab.com:42080
# LOCAL_API_BASIC_AUTH=Basic <仅在本机填写>
