{
  "name": "xueyuan-rebuild",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "pnpm --filter @xueyuan/web --fail-if-no-match dev",
    "build": "pnpm --filter @xueyuan/web --fail-if-no-match build",
    "typecheck": "pnpm --filter @xueyuan/web --fail-if-no-match typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @xueyuan/web --fail-if-no-match test",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:browser"
  }
}
