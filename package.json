{
  "name": "xueyuan-rebuild",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "pnpm --filter @xueyuan/web --fail-if-no-match dev",
    "build": "pnpm --filter @xueyuan/web --fail-if-no-match build",
    "typecheck": "pnpm --filter @workspace/ui --fail-if-no-match typecheck && pnpm --filter @xueyuan/web --fail-if-no-match typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @xueyuan/web --fail-if-no-match test",
    "test:browser": "playwright test",
    "test:browser:modes": "playwright test --config playwright.modes.config.ts",
    "evidence:generate": "python3 scripts/evidence_query.py generate --force",
    "evidence:verify": "python3 scripts/evidence_query.py verify",
    "evidence:query": "python3 scripts/evidence_query.py query",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:browser && pnpm test:browser:modes"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
